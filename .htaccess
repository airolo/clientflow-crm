# =============================================================
# ClientFlow CRM - Apache configuration
# -------------------------------------------------------------
# Blocks files that must never be served over HTTP but are needed
# inside the project folder (the SQL setup script, the README, the
# vendored asset notes) and turns off directory browsing.
#
# Requires Apache 2.4 with AllowOverride All, which is the XAMPP
# default. mod_rewrite is not needed.
# =============================================================

# No browsable directory listings anywhere in the project.
Options -Indexes

# Serve the correct MIME type for icon fonts (already the case on
# XAMPP, but explicit so the vendored icons work on other stacks).
<IfModule mod_mime.c>
    AddType font/woff2                .woff2
    AddType font/woff                 .woff
    AddType application/javascript    .js
    AddType text/css                  .css
</IfModule>

# Files that live in the web root for convenience but must not be
# downloadable: the SQL dump contains password hashes, the README
# contains demo credentials.
#
# FilesMatch tests the file NAME, not the path, so these are extensions
# rather than leading-dot patterns.
<FilesMatch "(?i)\.(sql|md|log|ini|env|bak|old|orig|dist|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Same for editor and VCS droppings.
<FilesMatch "(?i)(\.htaccess|\.htpasswd|\.gitignore|\.gitattributes)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Application internals are never fetched directly: PHP includes them from
# the filesystem, so there is no legitimate HTTP request for them. The
# per-directory .htaccess files repeat this so it still holds on a server
# without mod_rewrite.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|views)(?:/|$) - [F,L]

    # Version-control internals must never be served, even if the project
    # folder is inside the document root and a repo was initialised there.
    RewriteRule (^|/)\.git(?:/|$) - [F,L]
    RewriteRule (^|/)\.(?:svn|hg)(?:/|$) - [F,L]
</IfModule>

# Same protection without mod_rewrite.
RedirectMatch 404 /\.git
RedirectMatch 404 /\.svn
RedirectMatch 404 /\.hg

# ---------------------------------------------------------------------
# Backwards compatibility
# ---------------------------------------------------------------------
# The pages used to sit loose in the project root. These redirects keep
# older bookmarks and any external links working after the move into
# feature folders. Remove this block once nothing points at the old paths.
<IfModule mod_rewrite.c>
    RewriteRule ^login\.php$            auth/login.php       [END]
    RewriteRule ^logout\.php$           auth/logout.php      [END]
    RewriteRule ^profile\.php$          auth/profile.php     [END]

    RewriteRule ^clients\.php$          clients/index.php    [END]
    RewriteRule ^client_form\.php(.*)$  clients/form.php$1   [END]
    RewriteRule ^client_view\.php(.*)$  clients/view.php$1   [END]
    RewriteRule ^client_action\.php(.*)$ clients/action.php$1 [END]

    RewriteRule ^leads\.php$            leads/index.php      [END]
    RewriteRule ^lead_form\.php(.*)$    leads/form.php$1     [END]
    RewriteRule ^lead_view\.php(.*)$    leads/view.php$1     [END]
    RewriteRule ^lead_action\.php(.*)$  leads/action.php$1   [END]

    RewriteRule ^pipeline\.php$         pipeline/index.php   [END]
    RewriteRule ^deal_form\.php(.*)$    pipeline/form.php$1  [END]
    RewriteRule ^deal_action\.php(.*)$  pipeline/action.php$1 [END]

    RewriteRule ^tasks\.php$            tasks/index.php      [END]
    RewriteRule ^task_form\.php(.*)$    tasks/form.php$1     [END]
    RewriteRule ^task_action\.php(.*)$  tasks/action.php$1   [END]

    RewriteRule ^activities\.php$       activities/index.php [END]
    RewriteRule ^activity_form\.php(.*)$    activities/form.php$1    [END]
    RewriteRule ^activity_action\.php(.*)$  activities/action.php$1  [END]

    RewriteRule ^reports\.php$          reports/index.php    [END]

    RewriteRule ^users\.php$            admin/users.php      [END]
    RewriteRule ^user_form\.php(.*)$    admin/user_form.php$1 [END]
    RewriteRule ^user_action\.php(.*)$  admin/user_action.php$1 [END]
</IfModule>

# Sensible hardening for the pages that do get served.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Do not advertise the PHP version.
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>
